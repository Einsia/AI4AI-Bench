# Direct dependencies compiled into runtime-requirements.lock by
# environment/resolve_wheelhouse.sh. RAGEN and its pinned verl 0.6.1 tree run from
# PYTHONPATH rather than as installed packages, so their runtime dependencies are
# explicit here. The CUDA 12.8/Torch 2.8 base and vLLM 0.11 fall within verl's
# declared range and provide kernels for the target accelerator.

# ---- verl 0.6.1 install_requires ------------------------------------------------
accelerate
codetiming
dill
peft
pybind11
pylatexenc
tensorboard
torchdata
wandb
packaging>=20.0
pyarrow>=19.0.0
# 4.55.4 because that is the pin in verl 0.6.1's own reference Dockerfile
# (`transformers[hf_xet]==4.55.4`). Left unpinned it resolves to transformers 5.x --
# vllm 0.11.0 asks for `transformers>=4.55.2` with no upper bound -- and 5.x is a
# major-version API break that both vllm 0.11.0 and verl 0.6.1 predate. verl even
# carries verl/utils/transformers_compat.py to gate on the version.
transformers==4.55.4
# hydra 1.x, not the 0.11.3 an unpinned resolve lands on. RAGEN's train.py and
# ragen/eval.py both use `@hydra.main(version_base=None, ...)`, which is >=1.2 only,
# and ragen/utils.py calls OmegaConf.register_new_resolver, which is omegaconf >=2.1.
# The 2019 pair resolves cleanly and then fails at the first decorator.
#
# Both of these pin antlr4-python3-runtime==4.9.*, which PyPI has as an sdist only, so
# resolve_wheelhouse.sh pre-builds that wheel. That is why an unpinned resolve
# backtracks this far: --only-binary :all: drops antlr 4.9, which drops every hydra
# 1.x, and 0.11.3 is the newest release with no antlr dependency at all.
hydra-core==1.3.2
omegaconf==2.3.0
# Upper bounds, not exact pins: verl 0.6.1 leaves both unpinned, and what it was
# actually built against is the 2.x/4.x era. pandas 3 and datasets 5 are both
# major-version breaks released after it.
pandas<3
datasets<5
# The tensordict range is verl 0.6.1's own, 0.9.0 excluded by it and not by us.
tensordict>=0.8.0,<=0.10.0,!=0.9.0
# verl asks for the [default] extra, and run.sh hands Ray
# +ray_kwargs.ray_init.num_cpus=32, so the dashboard/runtime half is in use.
ray[default]>=2.41.0
# Pinned below 2 twice over: verl 0.6.1 requires numpy<2.0.0, and gym 0.26.2 refuses
# NumPy 2 at import with "Gym has been unmaintained since 2022 and does not support
# NumPy 2.0". 1.26.4 is what the old ragen.Dockerfile pinned, so this is also the
# version required by the pinned runtime. The base ships numpy 2.3.2, so this is a
# deliberate downgrade of a base package -- the only one.
numpy==1.26.4

# ---- verl 0.6.1's [vllm] extra --------------------------------------------------
# The top of verl 0.6.1's supported range and what it ships as stable. Requires
# torch==2.8.0, which the base already satisfies at 2.8.0+cu128, so the base's torch
# is not replaced -- the thing the wheelhouse resolver exists to prevent.
vllm==0.11.0

# ---- what RAGEN's own code imports ---------------------------------------------
# ragen/env/sokoban/env.py: `import gym` and
# `from gym_sokoban.envs.sokoban_env import SokobanEnv`. Not replaceable by
# gymnasium -- that would mean editing the frozen environment, which is the one tree
# whose bytes the final's guarantee rests on.
#
# gym 0.26.2 is sdist-only on PyPI. environment/resolve_wheelhouse.sh builds the
# wheel once, with network, and stages it; the build itself stays --network=none and
# --only-binary=:all:.
gym==0.26.2
gym-sokoban==0.0.6
# ragen/env/frozen_lake, imported eagerly by ragen/env/__init__.py.
gymnasium[toy-text]==1.2.1
# ragen/env/sokoban/utils.py imports matplotlib at module scope, and that file holds
# generate_room -- the board generator. Not optional: no matplotlib, no boards.
matplotlib
# ragen/llm_agent/base_llm.py imports all three at module scope, and
# ragen/llm_agent/agent_proxy.py -- the rollout entry point both evaluators invoke --
# imports base_llm. Unused at runtime for a local vLLM policy; still required to
# import, so leaving them out breaks scoring, not just the closed-model path.
anthropic
openai
together
# Imported directly by ragen (agent_proxy, ctx_manager, train.py). omegaconf is pinned
# up with hydra-core above, since the two versions have to agree.
tqdm
# ragen/llm_agent/es_manager.py imports PIL.Image. Already in the base at 11.0.0, so
# this adds no wheel -- it is here so the requirement is written down somewhere.
pillow

# ---- deliberately absent -------------------------------------------------------
# flash-attn      sdist-only, needs a CUDA toolchain, and not reached: RAGEN reads
#                 use_remove_padding with a False default in dp_actor.py,
#                 dp_critic.py and fsdp_workers.py, verl's generated PPO config
#                 defaults it false, and the compat patch plus run.sh both force
#                 attn_implementation=sdpa. The old base had no flash-attn either,
#                 which is why the patch exists at all.
# faiss-cpu       RAGEN declares it, but only ragen/env/search's retrieval server
#                 uses it, and that env is inside a try/except ImportError.
# IPython         declared by RAGEN, imported nowhere in the tree.
# debugpy         declared by RAGEN, imported nowhere in the tree.
