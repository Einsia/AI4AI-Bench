+    def wake_up_replicas(self):
+        """Restore teacher KV caches before distillation scoring."""
+        _run_all(
+            [
+                replica.wake_up()
+                for manager in self.teacher_model_managers.values()
+                for replica in manager.rollout_replicas
+            ]
+        )
+
+    def sleep_replicas(self):
+        """Release teacher KV caches before colocated actor training."""
+        _run_all(
+            [
+                replica.sleep()
+                for manager in self.teacher_model_managers.values()
+                for replica in manager.rollout_replicas
+            ]
+        )
